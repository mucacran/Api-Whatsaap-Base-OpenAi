  {static} + get_conversations() : array
  {static} + get_conversation(conversation_id : int) : object|null
  {static} + get_messages(conversation_id : int) : array
  {static} + mark_read(conversation_id : int) : void
}

class Mucacran_Wa_Ai_Webhook_Controller {
  + register_routes() : void
